# ---------------------------------------------------------------------------
# FieldPilot environment. Copy to .env.local for dev. NEVER commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres (docker compose up -d gives you this exact URL)
DATABASE_URL=postgres://fieldpilot:fieldpilot@localhost:5432/fieldpilot

# 32+ char secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- AssemblyAI (server-side only; never shipped to the browser) ------------
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_HOST=streaming.assemblyai.com
# u3-rt-pro | universal-streaming-english | universal-streaming-multilingual
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
ASSEMBLYAI_TOKEN_TTL_SECONDS=60

# --- LLM (AssemblyAI LLM Gateway is OpenAI-compatible) ---------------------
AI_BASE_URL=https://llm-gateway.assemblyai.com/v1
AI_API_KEY=
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_SMART=claude-sonnet-4.6
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# --- Cost governor (USD). Hard ceilings; nothing runs unbounded. -----------
AI_COST_LIMIT_PER_SESSION=0.15
AI_COST_LIMIT_PER_USER_DAY=1.00
AI_COST_LIMIT_PER_ORG_MONTH=25.00
VOICE_SESSION_MAX_SECONDS=600
VOICE_MAX_MODEL_CALLS_PER_SESSION=25
VOICE_MAX_TOOL_CALLS_PER_SESSION=12
MAX_TRANSCRIPT_CHARS=1200

# --- Licensing -------------------------------------------------------------
# "hosted" = our own service, governed by the terms of service, no key needed.
# "self-hosted" = a customer running their own instance; requires a signed key.
DEPLOYMENT_MODE=hosted
LICENSE_KEY=
LICENSE_SIGNING_SECRET=

# --- Sarvam: Indian-language speech and inference ---------------------------
# Optional. Without it the product runs English-only through AssemblyAI.
# Sarvam handles Hindi, Bengali, Marathi, Telugu, Tamil, Kannada, Gujarati,
# Malayalam and Punjabi, including code-mixed speech ("pump 3 mein vibration").
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_LLM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_LLM_MODEL=sarvam-105b
# Speech output is the priciest part of an Indic turn. Set false to stay text-only.
SARVAM_TTS_ENABLED=true

# --- Commercial model ------------------------------------------------------
# Credits are what the customer sees; provider tokens are what we pay for.
# Deterministic and cached turns cost nothing - the customer is never charged
# for work we did not pay a provider to do.
CREDITS_FREE_PER_MONTH=25
CREDITS_PRO_PER_MONTH=600
# Realised revenue per credit, in USD. Set to the LOWEST per-credit rate across
# the packs (the 1,500 pack at Rs 1.199/credit) so margin reporting undercounts
# rather than flatters. Change it whenever pack pricing changes.
CREDIT_PRICE_USD=0.0136
CREDITS_PER_FAST_TURN=1
CREDITS_PER_REASONING_TURN=2

# --- Payments --------------------------------------------------------------
# "mock" fulfils purchases instantly without a provider - use it in development.
# Switch to "razorpay" once the keys below are real. Never commit real keys.
PAYMENTS_PROVIDER=mock
PAYMENTS_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Rate limits -----------------------------------------------------------
# How many proxies append to x-forwarded-for. Vercel alone = 1; Cloudflare in
# front of Vercel = 2. Getting this wrong makes IP limits spoofable.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_AUTH_PER_IP=30

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Feature flags ---------------------------------------------------------
FEATURE_VOICE_AGENT=true
FEATURE_TOOL_EXECUTION=true
FEATURE_OUTCOME_LEDGER=true
FEATURE_DEMO_MODE=true

LOG_LEVEL=info
